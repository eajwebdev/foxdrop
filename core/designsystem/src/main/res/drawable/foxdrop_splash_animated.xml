<?xml version="1.0" encoding="utf-8"?>
<!-- Splash icon (§11A.1): the fox mark dashes in from the left and settles with a small overshoot (700 ms).
     On API < 31 core-splashscreen shows the vector's resting state (centred), so no half-animated frame. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/foxdrop_splash_mark">
    <target android:name="mark">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:duration="700"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="translateX"
                    android:valueFrom="-260"
                    android:valueTo="0"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="550"
                    android:interpolator="@android:interpolator/decelerate_cubic"
                    android:propertyName="scaleX"
                    android:valueFrom="0.55"
                    android:valueTo="1"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="550"
                    android:interpolator="@android:interpolator/decelerate_cubic"
                    android:propertyName="scaleY"
                    android:valueFrom="0.55"
                    android:valueTo="1"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="700"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="rotation"
                    android:valueFrom="-8"
                    android:valueTo="0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
