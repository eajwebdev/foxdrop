# Copy to local.properties (never committed). Android Studio adds sdk.dir automatically.
#
# Supabase — public client values only. NEVER put the service_role key here.
# Local stack (`supabase start`), from the Android emulator:
#   SUPABASE_URL=http://10.0.2.2:54321
#   SUPABASE_ANON_KEY=<"Publishable key" / anon key printed by `supabase start`>
# Hosted project: Supabase dashboard > Project Settings > API.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Google sign-in: OAuth "Web application" client ID (public). Empty = the Google button says "coming soon".
GOOGLE_WEB_CLIENT_ID=

# Google Maps (from Phase 2): key restricted to the apps' package names + SHA-1.
MAPS_API_KEY=
